<h1>Edit Task Page</h1>

<%= form_with model: @task, local: true do |f| %>
  <div>
    <%= f.label :title, "Title" %>
    <%= f.text_field :title %>
    <% if @task.errors[:title].any? %>
      <span style="color: red;"><%= @task.errors[:title].join(", ") %></span>
    <% end %>
  </div>

  <div>
    <%= f.label :content, "Content" %>
    <%= f.text_area :content %>
    <% if @task.errors[:content].any? %>
      <span style="color: red;"><%= @task.errors[:content].join(", ") %></span>
    <% end %>
  </div>

  <div>
    <%= f.submit "Update Task", id: "update-task" %>
  </div>
<% end %>

<%= link_to "Back", tasks_path, id: "back" %>