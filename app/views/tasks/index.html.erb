<h1>Task List Page</h1>

<%= form_with url: tasks_path, method: :get, local: true do %>
  <div class="form-row">
    <div class="form-group col-md-3">
      <%= label_tag :status, "Status" %>
      <%= select_tag :status,
            options_for_select([["Not yet started", 0], ["In progress", 1], ["Completed", 2]], params[:status]),
            include_blank: true,
            class: "form-control" %>
    </div>

    <div class="form-group col-md-4">
      <%= label_tag :title, "Title" %>
      <%= text_field_tag :title, params[:title], class: "form-control" %>
    </div>

    <div class="form-group col-md-5">
      <%= label_tag :label_id, "Labels" %>
      <%= select_tag :label_id,
            options_from_collection_for_select(current_user.labels, :id, :name, params[:label_id]),
            include_blank: true,
            class: "form-control" %>
    </div>
  </div>

  <div class="text-right">
    <%= submit_tag "Search", class: "btn btn-primary" %>
  </div>
<% end %>

<table class="table mt-5">
  <thead>
    <tr>
      <th>Title</th>
      <th>Contents</th>
      <th>Creation date</th>
      <th><%= link_to "Expiration date", tasks_path(sort_expired: "true") %></th>
      <th><%= link_to "Priority", tasks_path(sort_priority: "true") %></th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td><%= task.created_at.strftime("%Y/%m/%d %H:%M") %></td>
        <td><%= task.deadline_on %></td>
        <td><%= task.priority %></td>
        <td><%= task.status %></td>
        <td>
          <%= link_to "show", task_path(task), class: "show-task btn btn-info btn-sm" %>
          <%= link_to "edit", edit_task_path(task), class: "edit-task btn btn-primary btn-sm" %>
          <%= link_to "delete", task_path(task),
                      method: :delete,
                      data: { confirm: "Are you sure you want to delete this task?" },
                      class: "destroy-task btn btn-danger btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @tasks %>