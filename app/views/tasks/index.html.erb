<h1><%= t('tasks.index.title') %></h1>

<%= link_to t('tasks.index.new'), new_task_path %>

<hr>

<%= form_with(url: tasks_path, method: :get, local: true) do |f| %>
  <div>
    <%= f.label :title, "Title" %>
    <%= f.text_field :title, value: params[:title] %>

    <%= f.label :status, "Status" %>
    <%= f.select :status,
                 Task.statuses.keys.map { |status| [status.humanize, status] },
                 { include_blank: "All" },
                 { selected: params[:status] } %>

    <%= f.submit "Search" %>
  </div>
<% end %>

<hr>

<table>
  <thead>
    <tr>
      <th><%= Task.human_attribute_name(:title) %></th>
      <th><%= Task.human_attribute_name(:content) %></th>

      <th>
        <%= link_to "End Date", tasks_path(sort_deadline_on: true) %>
      </th>

      <th>
        <%= link_to "Priority", tasks_path(sort_priority: true) %>
      </th>

      <th>Status</th>

      <th><%= Task.human_attribute_name(:created_at) %></th>

      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>

        <td><%= task.deadline_on %></td>

        <td><%= task.priority.humanize %></td>

        <td><%= task.status.humanize %></td>

        <td><%= task.created_at.strftime("%Y-%m-%d %H:%M") %></td>

        <td>
          <%= link_to t('tasks.index.show'),
                      task_path(task),
                      class: "show-task" %>

          <%= link_to t('tasks.index.edit'),
                      edit_task_path(task),
                      class: "edit-task" %>

          <%= link_to t('tasks.index.destroy'),
                      task_path(task),
                      method: :delete,
                      data: {
                        confirm: "Are you sure you want to delete this task?"
                      },
                      class: "destroy-task" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="pagination">
  <%= paginate @tasks %>
</div>