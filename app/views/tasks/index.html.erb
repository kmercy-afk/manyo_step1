<h1><%= t('tasks.index.title') %></h1>

<%= link_to t('tasks.index.new'), new_task_path, id: "new-task-link" %>

<table>
  <thead>
    <tr>
      <th><%= Task.human_attribute_name(:title) %></th>
      <th><%= Task.human_attribute_name(:content) %></th>
      <th><%= t('activerecord.attributes.task.created_at') %></th>
      <th colspan="3"><%= t('tasks.index.show') %> / <%= t('tasks.index.edit') %> / <%= t('tasks.index.destroy') %></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td><%= task.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        <td>
          <%= link_to t('tasks.index.show'), task_path(task), class: "show-task" %>
          <%= link_to t('tasks.index.edit'), edit_task_path(task), class: "edit-task" %>
          <%= link_to t('tasks.index.destroy'),
              task_path(task),
              data: { turbo_method: :delete, turbo_confirm: t('tasks.index.confirm') },
              class: "destroy-task" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @tasks.empty? %>
  <p><%= t('tasks.index.no_tasks', default: "No tasks yet.") %></p>
<% end %>

<%= paginate @tasks %>