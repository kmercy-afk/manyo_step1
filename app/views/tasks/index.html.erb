<h1><%= t('tasks.index.title') %></h1>

<%= link_to t('tasks.index.new'), new_task_path %>

<table>
  <thead>
    <tr>
      <th><%= Task.human_attribute_name(:title) %></th>
      <th><%= Task.human_attribute_name(:content) %></th>
      <th><%= Task.human_attribute_name(:created_at) %></th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td><%= task.created_at.strftime("%Y-%m-%d %H:%M") %></td>

        <td>
          <%= link_to t('tasks.index.show'),
                      task_path(task),
                      class: "show-task" %>

          <%= link_to t('tasks.index.edit'),
                      edit_task_path(task),
                      class: "edit-task" %>

          <%= link_to t('tasks.index.destroy'),
            task_path(task),
            method: :delete,
            data: {
              confirm: "Are you sure you want to delete this task?"
            },
            class: "destroy-task" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="pagination">
  <%= paginate @tasks %>
</div>