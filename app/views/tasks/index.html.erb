<h1><%= t('tasks.index.title') %></h1>

<%= link_to t('tasks.index.new'), new_task_path %>

<%= form_with url: tasks_path, method: :get, local: true do |form| %>
  <div>
    <%= form.label :title, 'Title' %>
    <%= form.text_field :title, value: params[:title] %>
  </div>

  <div>
    <%= form.label :status, 'Status' %>
    <%= form.select :status,
                    Task.statuses.keys.map { |status| [status.humanize, status] },
                    { include_blank: true, selected: params[:status] } %>
  </div>

  <div>
    <%= form.submit 'Search' %>
  </div>
<% end %>

<p>
  <%= link_to 'Sort by deadline', tasks_path(sort: 'deadline') %>
  |
  <%= link_to 'Sort by priority', tasks_path(sort: 'priority') %>
</p>

<table>
  <thead>
    <tr>
      <th><%= Task.human_attribute_name(:title) %></th>
      <th><%= Task.human_attribute_name(:content) %></th>
      <th><%= Task.human_attribute_name(:created_at) %></th>
      <th><%= Task.human_attribute_name(:deadline_on) %></th>
      <th><%= Task.human_attribute_name(:priority) %></th>
      <th><%= Task.human_attribute_name(:status) %></th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td><%= task.created_at.strftime('%Y-%m-%d %H:%M') %></td>
        <td><%= task.deadline_on %></td>
        <td><%= task.priority.humanize %></td>
        <td><%= task.status.humanize %></td>

        <td>
          <%= link_to t('tasks.index.show'),
                      task_path(task),
                      class: 'show-task' %>

          <%= link_to t('tasks.index.edit'),
                      edit_task_path(task),
                      class: 'edit-task' %>

          <%= link_to t('tasks.index.destroy'),
                      task_path(task),
                      method: :delete,
                      data: { confirm: 'Are you sure you want to delete this task?' },
                      class: 'destroy-task' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="pagination">
  <%= paginate @tasks %>
</div>