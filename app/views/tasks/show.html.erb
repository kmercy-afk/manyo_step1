<h1>Task Detail Page</h1>

<p>Title: <%= @task.title %></p>
<p>Content: <%= @task.content %></p>
<p>Creation Date: <%= @task.created_at.strftime("%Y/%m/%d %H:%M") %></p>
<p>Expiration Date: <%= @task.deadline_on %></p>
<p>Priority: <%= ["Low", "Middle", "High"][@task.priority.to_i] %></p>
<p>Status: <%= ["Not yet started", "In progress", "Completed"][@task.status.to_i] %></p>

<p>
  Label:
  <%= @task.labels.map(&:name).join(" ") %>
</p>

<%= link_to "Edit", edit_task_path(@task), class: "btn btn-primary" %>
<%= link_to "Back", tasks_path, class: "btn btn-secondary" %>