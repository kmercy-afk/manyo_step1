<h1><%= t('tasks.show.title') %></h1>

<p>
  <strong><%= Task.human_attribute_name(:title) %>:</strong>
  <%= @task.title %>
</p>

<p>
  <strong><%= Task.human_attribute_name(:content) %>:</strong>
  <%= @task.content %>
</p>

<p>
  <strong>End Date:</strong>
  <%= @task.deadline_on %>
</p>

<p>
  <strong>Priority:</strong>
  <%= @task.priority.humanize %>
</p>

<p>
  <strong>Status:</strong>
  <%= @task.status.humanize %>
</p>

<p>
  <strong><%= Task.human_attribute_name(:created_at) %>:</strong>
  <%= l(@task.created_at) %>
</p>

<%= link_to t('tasks.show.edit'),
            edit_task_path(@task),
            id: "edit-task" %>

<%= link_to t('tasks.show.back'),
            tasks_path,
            id: "back" %>