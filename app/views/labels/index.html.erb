<h1>Label list page</h1>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Number of tasks</th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @labels.each do |label| %>
      <tr>
        <td><%= label.name %></td>
        <td><%= label.tasks.count %></td>

        <td>
          <%= link_to "edit",
                      edit_label_path(label),
                      class: "edit-label btn btn-primary btn-sm" %>
        </td>

        <td>
          <%= link_to "delete",
                        label_path(label),
                        method: :delete,
                        data: { confirm: "Are you sure you want to delete the label?" },
                        class: "destroy-label" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>