<h1>Label list page</h1>

<table class="table">
  <thead>
    <tr>
      <th>Name</th>
      <th>number of tasks</th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @labels.each do |label| %>
      <tr>
        <td><%= label.name %></td>
        <td><%= label.tasks.count %></td>
        <td><%= link_to "edit", edit_label_path(label), class: "edit-label btn btn-primary" %></td>
        <td><%= link_to "delete", label_path(label), method: :delete, data: { confirm: "Are you sure you want to delete this?" }, class: "destroy-label btn btn-danger" %></td>
      </tr>
    <% end %>
  </tbody>
</table>