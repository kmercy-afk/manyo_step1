<!DOCTYPE html>
<html>
  <head>
    <title>Task App</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <nav class="navbar navbar-light bg-light">
      <%= link_to "Task App", tasks_path, class: "navbar-brand" %>

      <div class="d-flex flex-row ml-auto">
        <%= link_to "Users list", users_path, class: "nav-link" %>
        <%= link_to "Register your user", new_user_path, class: "nav-link" %>
        <%= link_to "Task List", tasks_path, id: "tasks-index", class: "nav-link" %>
        <%= link_to "Register a task", new_task_path, id: "new-task", class: "nav-link" %>
        <%= link_to "Label List", labels_path, id: "labels-index", class: "nav-link" %>
        <%= link_to "Register a label", new_label_path, id: "new-label", class: "nav-link" %>
        <%= link_to "Account details", user_path(current_user), class: "nav-link" if logged_in? %>
        <%= link_to "Logout", session_path, method: :delete, class: "nav-link" if logged_in? %>
      </div>
    </nav>

    <% if notice %>
      <div class="alert alert-success"><%= notice %></div>
    <% end %>

    <% if alert %>
      <div class="alert alert-danger"><%= alert %></div>
    <% end %>

    <div class="container mt-4">
      <%= yield %>
    </div>
  </body>
</html>