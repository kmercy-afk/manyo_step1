<body>

<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <%= link_to "Task App", tasks_path, class: "navbar-brand" %>

  <div class="collapse navbar-collapse justify-content-end">
    <div class="navbar-nav">

      <%= link_to "Users list", "#", class: "nav-item nav-link" %>

      <%= link_to "Register your user", "#", class: "nav-item nav-link" %>

      <%= link_to "Task List",
                  tasks_path,
                  id: "tasks-index",
                  class: "nav-item nav-link" %>

      <%= link_to "Register a task",
                  new_task_path,
                  id: "new-task",
                  class: "nav-item nav-link" %>

      <%= link_to "Label List",
                  labels_path,
                  id: "labels-index",
                  class: "nav-item nav-link" %>

      <%= link_to "Register a label",
                  new_label_path,
                  id: "new-label",
                  class: "nav-item nav-link" %>

      <%= link_to "Account details", "#", class: "nav-item nav-link" %>

      <%= link_to "Logout", "#", class: "nav-item nav-link" %>

    </div>
  </div>
</nav>

<% if notice %>
  <div class="alert alert-success">
    <%= notice %>
  </div>
<% end %>

<% if alert %>
  <div class="alert alert-danger">
    <%= alert %>
  </div>
<% end %>

<div class="container mt-4">
  <%= yield %>
</div>

</body>